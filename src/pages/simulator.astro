---
import Base from '../layouts/Base.astro';
import Simulator from '../components/sim/Simulator.tsx';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

/* The assumptions worth arguing with. The formulas themselves live in the code. */
const assumptions: [string, string][] = [
  ['HBM read efficiency', '80% of the spec sheet'],
  ['Usable HBM', '90% of capacity'],
  ['MFU', '55% prefill, 75% decode'],
  ['Kernel launch', '120 µs per step, CUDA-graphed'],
  ['NVLink hop', '3 µs, half the bidirectional rate'],
  ['InfiniBand hop', '9 µs, 50 GB/s per GPU'],
  ['NVMe offload', '14 GB/s per GPU'],
  ['Chunked prefill', '512-token chunks'],
  ['MoE tile fill', 'floor 30%, full at 96 tokens per expert'],
  ['Duty cycle', '45% static, 85% continuous, 90% chunked, 92% split'],
  ['Chunked-prefill TTFT', '+15% for the chunking itself'],
  ['Static-batching queue', 'one batch of 64 steps ahead of you'],
  ['Activations + workspace', '6% of the BF16 weights, plus 1.5 GB fixed'],
  ['Video activations', 'eight residual-sized tensors per layer'],
  ['Emulated format', "85% of the part's 16-bit rate"],
];

/* The picker only offers formats the selected part has tensor cores for, but the roofline still
   draws the other parts, and a part that lacks the format gets its ghost roof taxed — so the
   emulation derate does reach the reader and is listed above. */
---
<Base
  title="A roofline you can drag — Youngmin Cho"
  description="An interactive back-of-the-envelope simulator for LLM and video-diffusion inference: precision, KV cache layout, GPU count, interconnect, and serving discipline."
>
  <div class="wrap">
    <header class="sim-hero">
      <a class="back" href={base}>← Youngmin Cho</a>
      <p class="eyebrow">Toy simulator</p>
      <h1>A roofline you can drag</h1>
      <p class="sim-lead">
        A simple toy roofline simulator. I use it to get a rough sense of how much hardware a given
        inference workload needs.
      </p>
    </header>

    <Simulator client:load />

    <section class="method" id="method">
      <div class="method-head">
        <p class="eyebrow">Method</p>
        <h2>How the numbers are made</h2>
        <p class="method-lead">
          A decode step costs whichever is slower, reading the weights or doing the arithmetic, plus
          the collectives, which do not overlap with either. KV cache shards across ranks until every
          rank owns one key-value head and then stops. A mixture-of-experts layer reads only the
          experts its batch happens to touch, but all of them still have to be resident. A diffusion
          transformer attends in both directions, so its attention term is quadratic and not halved.
          Everything else is a spec sheet and a derate.
        </p>
      </div>

      <div class="method-group">
        <h3>Derates</h3>
        <ul class="assume">
          {assumptions.map(([k, v]) => <li><span>{k}</span><b>{v}</b></li>)}
        </ul>
      </div>

      <div class="method-group">
        <h3>What it does not model</h3>
        <p class="method-note">
          Paged-attention fragmentation, prefix-cache hits, speculative decoding, and pipeline or
          expert parallelism as separate axes — every GPU count here is tensor-parallel. Mixture of
          experts at batch 1 is the weakest case and reads optimistic; batched serving, the regime
          anyone actually deploys, lands within about a factor of two of published measurements.
        </p>
      </div>
    </section>

    <nav class="sim-foot">
      <a href={base}>← Back to the CV</a>
      <a href={`${base}#research`}>Research focus</a>
    </nav>
  </div>

  <style>
    .sim-hero{padding:56px 0 26px; max-width:74ch}
    .back{font-family:var(--mono); font-size:12px; letter-spacing:.06em; color:var(--muted);
      display:inline-block; margin-bottom:26px}
    .back:hover{color:var(--accent); text-decoration:none}
    .sim-hero h1{font-size:clamp(36px,5.4vw,56px); line-height:1.02; letter-spacing:-.045em; margin:0 0 16px}
    .sim-lead{color:var(--ink-2); font-size:17px; line-height:1.62; margin:0}

    .method{margin:70px 0 0; padding-top:44px; border-top:1px solid var(--line)}
    .method-head{max-width:70ch; margin-bottom:34px}
    .method-head h2{margin:0 0 12px; padding-bottom:12px}
    .method-lead{color:var(--ink-2); font-size:16px; line-height:1.6; margin:0}
    .method-group{margin:0 0 34px}
    .method-group h3{font-size:13px; font-family:var(--mono); font-weight:600; letter-spacing:.12em;
      text-transform:uppercase; color:var(--ink); margin:0 0 14px; padding-bottom:9px;
      border-bottom:1px solid var(--line)}
    .assume{list-style:none; margin:0; padding:0; display:grid;
      grid-template-columns:repeat(auto-fit,minmax(360px,1fr)); gap:0 40px}
    .assume li{display:flex; justify-content:space-between; align-items:baseline; gap:14px;
      padding:9px 0; border-bottom:1px solid var(--line); font-size:14px}
    .assume span{color:var(--ink-2)}
    .assume b{font-family:var(--mono); font-size:12.5px; color:var(--ink); text-align:right}
    .method-note{font-size:14.5px; color:var(--ink-2); line-height:1.65; max-width:78ch; margin:0 0 16px}
    .sim-foot{display:flex; gap:20px; flex-wrap:wrap; margin:56px 0 0; padding-top:22px;
      border-top:1px solid var(--line); font-size:14px; font-weight:600}
  </style>
</Base>
