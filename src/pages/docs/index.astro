---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const docs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Docs — Youngmin Cho" description="OMNIX docs: Nucleus NPU and OMMX GPU kernel. Structure only for now.">
  <div class="doc-layout">
    <aside class="docnav">
      <div class="k">Docs</div>
      <a href={`${base}docs/`} class="active">Overview</a>
      {docs.map((d) => (
        <a href={`${base}docs/${d.id}/`}>{d.data.title}</a>
      ))}
    </aside>
    <div>
      <h1>OMNIX Docs</h1>
      <p class="lead">Two systems, one OMMX stack. Documentation structure is in place — prose is added incrementally.</p>
      <h2>Core pages</h2>
      <div class="cards">
        {docs.map((d) => (
          <div class="card">
            <div class="k">Section</div>
            <h3><a href={`${base}docs/${d.id}/`}>{d.data.title}</a></h3>
            {d.data.summary && <p>{d.data.summary}</p>}
          </div>
        ))}
      </div>
      <p style="color:var(--muted); font-size:13.5px; margin-top:18px">
        ⓘ Docs content is intentionally a skeleton for now (navigation + section structure). Full pages land later.
      </p>
    </div>
  </div>
</Base>
